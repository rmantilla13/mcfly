// Copy to Local.xcconfig (that file stays uncommitted). A key set here wins
// over Config/Defaults.xcconfig. xcconfig treats // as a comment, so write
// a URL's scheme as https:/$()/

// Required for a real backend (a device run, the Mac app, TestFlight).
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Required to run on an iPhone or to sign the Mac app.
// MCFLY_TEAM_ID = ABCDE12345
// MCFLY_BUNDLE_ID = bot.mcfly.app
