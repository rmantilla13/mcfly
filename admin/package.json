{
  "name": "mcfly-admin",
  "version": "0.1.0",
  "private": true,
  "description": "McFly admin console (Next.js + Supabase)",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_ADMIN_DEMO=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "predev": "node scripts/copy-voice-runtime.mjs",
    "prebuild": "node scripts/copy-voice-runtime.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.57.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
